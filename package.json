{
  "name": "rixse-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "demos/*"
  ],
  "scripts": {
    "test": "npm test -w rixse && node --test bench/*.test.js conformance/*.test.js",
    "bench": "node --experimental-strip-types bench/run.mjs && node --experimental-strip-types bench/report.mjs",
    "demo": "npm run dev -w rixse-demo-canvas"
  },
  "devDependencies": {
    "react-server-dom-webpack": "19.2.0"
  }
}
