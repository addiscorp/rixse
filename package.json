{
  "name": "rixse",
  "version": "0.1.0",
  "description": "The gateway between an agent's VM, a vault and the internet: import { gateway } from 'rixse'.",
  "homepage": "https://github.com/addiscorp/rixse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addiscorp/rixse.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "agents",
    "gateway",
    "proxy",
    "approval",
    "audit",
    "vault"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/raw-tls-client.ts",
    "!src/tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./src/node.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./src/node.js"
    }
  },
  "bin": {
    "rixse": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test src && tsc -p src/tsconfig.json && node --test pack/*.test.js"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "bun-types": "1.4.4",
    "@types/node": "24.13.6"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@peculiar/x509": "1.12.3",
    "zod": "4.6.7"
  }
}
