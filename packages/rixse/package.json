{
  "name": "rixse",
  "version": "0.1.0",
  "description": "The gateway between a VM, a vault and the internet: import { gateway } from 'rixse'. Agentic UI core at rixse/ui.",
  "homepage": "https://rixse.dev",
  "repository": "https://rixse.dev",
  "license": "Apache-2.0",
  "keywords": [
    "agentic-ui",
    "ui",
    "agent",
    "state"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/gateway/tsconfig.json",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "main": "./src/gateway/node.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/gateway/index.ts",
      "bun": "./src/gateway/index.ts",
      "default": "./src/gateway/node.js"
    },
    "./ui": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "rixse": "./src/gateway/cli.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.js && tsc -p test/tsconfig.json",
    "test:gateway": "bun test src/gateway && tsc -p src/gateway/tsconfig.json"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "bun-types": "1.4.4",
    "@types/node": "24.13.6"
  },
  "types": "./src/gateway/index.ts",
  "dependencies": {
    "@peculiar/x509": "1.12.3",
    "zod": "4.6.7"
  }
}
